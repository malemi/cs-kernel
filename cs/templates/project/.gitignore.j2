.venv/
__pycache__/
*.pyc
*.pyo

# secrets & runtime state (PII) — live under ~/.{{ company_slug }}-cs/, never in the repo
.env
.env.local
*.db
*.sqlite*
# service-account keys / credentials — defensive: never let one slip into the repo
firebase-sa.json
*-sa.json
*sa*.json
*.pem
*.key

# generated dry-run queues / drafts / logs
queue/
drafts/
*.log


# runtime flock sidecars written next to a state file (e.g. a schedule CSV).
# In the template because `cs update` rewrites this file wholesale: a clone that
# added them itself had them stripped on the next update, and its lock files
# then showed up staged for commit.
*.csv.lock
# local fixtures: an underscore prefix marks a file that must never be mistaken
# for real state (acceptance-test schedules and the like).
_*.csv
# Per-session agent memory: one `<session-id>.md` per Claude Code session,
# holding that run's local handoff notes. It is per-machine, per-session state
# — no other machine can use it, and it names mailboxes, hosts and absolute
# paths. In the template because `cs update` rewrites this file wholesale: a
# clone that adds the line itself has it stripped on the next update.
docs/sessions/
