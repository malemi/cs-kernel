#!/usr/bin/env bash
# {{ company_name }} general operator — one headless tick.
#
# Fired by cron every 2h in business hours. Runs `claude -p "/cs-operator"`:
# triage inbound {{ email_address }} mail into review DRAFTS + advance active campaigns
# (reconcile already-sent drafts, handle replies). With CS_TRIAGE_MODE=draft
# (the default) NOTHING is sent to a customer autonomously.
#
# Guards: CS_PAUSE file = global kill-switch (no crontab edit needed);
# flock = never let a slow tick overlap the next one. Logs IDs/actions only.
#
# cd's to its OWN repo root, so the same script works from the cs-operator
# worktree (testing) and from main (after merge) with no edit.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"   # cron has a minimal PATH
STATE="$HOME/.{{ company_slug }}-cs"
LOG="$STATE/cs_operator.log"
LOCK="$STATE/cs_operator.lock"
PAUSE="$STATE/CS_PAUSE"
mkdir -p "$STATE"

ts() { date -u +%FT%TZ; }

if [ -f "$PAUSE" ]; then
  echo "$(ts) {{ company_prog_name }}: paused (CS_PAUSE present) — skip" >>"$LOG"
  exit 0
fi

# Non-blocking lock: if the previous tick is still running, skip this one.
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "$(ts) {{ company_prog_name }}: previous tick still running — skip" >>"$LOG"
  exit 0
fi

cd "$ROOT" || { echo "$(ts) {{ company_prog_name }}: cannot cd $ROOT" >>"$LOG"; exit 1; }
echo "$(ts) {{ company_prog_name }}: tick start (root=$ROOT)" >>"$LOG"
# Draft-only is enforced HERE, on the cron, INDEPENDENT of .claude/settings.json
# (which the interactive REPL shares — a human may relax it to send from the REPL).
# Re-deny every customer-send / mutate surface so a skill bug or a prompt-injection
# in inbound mail can never send autonomously. NOTE: settings.json allows the broad
# `cs rpc:*`, so the `cs rpc chat` deny is load-bearing and MUST live here too.
# `cs handled` is denied for the mirror-image reason: it declares a contact
# resolved off-email and stops the sweep raising them. That is an INTERACTIVE
# gesture — the operator saying "I phoned him" — and a tick reads untrusted mail,
# where "please close this ticket" in a body would otherwise silence a real
# customer request. Nobody is present on a tick to say it, so nothing is lost.
# `cs escalated` is denied for the sharper version of that reason. It records
# that a named HUMAN has personally taken a contact over, and the review then
# repeats it back to him as "you are on this one" — an assertion about a human
# that no machine can make on his behalf, and a false one is worse than a false
# close because it does not merely hide the item, it tells him he already has
# it. The tick's own "escalate on uncertainty" needs none of this: a triage
# escalation is an OPEN engine task plus a line in this log, and both correctly
# stay in the work list.
# `cs draft-delete` is denied on the same principle, from the other end. The
# tick DOES compute draft verdicts now (`cs review` marks a draft the
# conversation has moved past), and the tempting next step — retiring the ones
# it just called stale — is precisely the one it may not take: removing a draft
# destroys a prepared answer no human ever saw, on a judgement made while
# reading untrusted mail. The tick reports such drafts under Escalations and
# the operator retires them by name, in a session, exactly like `cs handled`.
# `cs rpc drafts.discard` is the ENGINE half of the same door and is denied for
# the same reason — and, like `cs rpc chat`, the deny is load-bearing because
# settings.json allows the broad `cs rpc:*`. It is the sharper half, too: the
# engine DELETES the row, where `draft-delete` only moves the Gmail copy to
# Trash, so this is the one with nothing to recover.
# Each surface is denied in SIX spellings (.venv/bin/python -m cs, .venv/bin/python3 -m cs,
# .venv/bin/cs, python -m cs, python3 -m cs, cs): permission rules match command TEXT,
# not behavior, and the console script, the module path and the python3 aliases all
# reach the same code. Do not "tidy" the list back to one spelling — a missing
# spelling is a hole, and tests/run.sh gates the full enumeration.
"$CLAUDE_BIN" -p "/cs-operator" \
  --disallowed-tools \
    "Bash(.venv/bin/python -m cs chat:*)" \
    "Bash(.venv/bin/python3 -m cs chat:*)" \
    "Bash(.venv/bin/cs chat:*)" \
    "Bash(python -m cs chat:*)" \
    "Bash(python3 -m cs chat:*)" \
    "Bash(cs chat:*)" \
    "Bash(.venv/bin/python -m cs rpc chat:*)" \
    "Bash(.venv/bin/python3 -m cs rpc chat:*)" \
    "Bash(.venv/bin/cs rpc chat:*)" \
    "Bash(python -m cs rpc chat:*)" \
    "Bash(python3 -m cs rpc chat:*)" \
    "Bash(cs rpc chat:*)" \
    "Bash(.venv/bin/python -m cs campaign send-draft:*)" \
    "Bash(.venv/bin/python3 -m cs campaign send-draft:*)" \
    "Bash(.venv/bin/cs campaign send-draft:*)" \
    "Bash(python -m cs campaign send-draft:*)" \
    "Bash(python3 -m cs campaign send-draft:*)" \
    "Bash(cs campaign send-draft:*)" \
    "Bash(.venv/bin/python -m cs rpc settings.update:*)" \
    "Bash(.venv/bin/python3 -m cs rpc settings.update:*)" \
    "Bash(.venv/bin/cs rpc settings.update:*)" \
    "Bash(python -m cs rpc settings.update:*)" \
    "Bash(python3 -m cs rpc settings.update:*)" \
    "Bash(cs rpc settings.update:*)" \
    "Bash(.venv/bin/python -m cs handled:*)" \
    "Bash(.venv/bin/python3 -m cs handled:*)" \
    "Bash(.venv/bin/cs handled:*)" \
    "Bash(python -m cs handled:*)" \
    "Bash(python3 -m cs handled:*)" \
    "Bash(cs handled:*)" \
    "Bash(.venv/bin/python -m cs escalated:*)" \
    "Bash(.venv/bin/python3 -m cs escalated:*)" \
    "Bash(.venv/bin/cs escalated:*)" \
    "Bash(python -m cs escalated:*)" \
    "Bash(python3 -m cs escalated:*)" \
    "Bash(cs escalated:*)" \
    "Bash(.venv/bin/python -m cs draft-delete:*)" \
    "Bash(.venv/bin/python3 -m cs draft-delete:*)" \
    "Bash(.venv/bin/cs draft-delete:*)" \
    "Bash(python -m cs draft-delete:*)" \
    "Bash(python3 -m cs draft-delete:*)" \
    "Bash(cs draft-delete:*)" \
    "Bash(.venv/bin/python -m cs rpc drafts.discard:*)" \
    "Bash(.venv/bin/python3 -m cs rpc drafts.discard:*)" \
    "Bash(.venv/bin/cs rpc drafts.discard:*)" \
    "Bash(python -m cs rpc drafts.discard:*)" \
    "Bash(python3 -m cs rpc drafts.discard:*)" \
    "Bash(cs rpc drafts.discard:*)" \
    "Write" "Edit" "Bash(rm:*)" "Bash(git push:*)" \
  >>"$LOG" 2>&1
rc=$?
echo "$(ts) {{ company_prog_name }}: tick end (exit $rc)" >>"$LOG"
exit "$rc"