[company]
name = "{{ company_name }}"
display_name = "{{ company_display_name }}"
from_name = "{{ company_from_name }}"
slug = "{{ company_slug }}"
prog_name = "{{ company_prog_name }}"

[operator]
email_address = "{{ email_address }}"
imap_host = "{{ imap_host }}"
imap_port = {{ imap_port }}
smtp_host = "{{ smtp_host }}"
smtp_port = {{ smtp_port }}

[engine]
owner_uid = "{{ engine_owner_uid }}"
ws_url = "{{ engine_ws_url }}"
# Empty on purpose: Settings derives ~/.{{ company_slug }}-cs/firebase-sa.json
# from the slug the moment this is blank — set it only to override that.
sa_path = ""

[engine.accounts]
default = {{ accounts_default | toml_quote }}
{% for name, uid in accounts.items() %}
{{ name | toml_quote }} = {{ uid | toml_quote }}
{% endfor %}

[engine.founder_sweep]
enabled = {{ 'true' if founder_sweep_enabled else 'false' }}
account = "{{ founder_sweep_account }}"

[crm]
adapter = "{{ crm_adapter }}"
{% if crm_adapter == 'shopify' and crm_shopify %}
[crm.shopify]
api_version = "{{ crm_shopify.api_version }}"
env_prefix = "{{ crm_shopify.env_prefix }}"
{% endif %}

[producer]
# mrcall-tracking's script/python paths are literal paths on MrCall's own
# ops box; `cs init` never wires this for a clone. Add [producer.mrcall_tracking]
# by hand (script_path, python_path) if this clone genuinely needs it.
adapter = "none"

[campaigns]
# Niche, per-campaign prose; `cs init` never asks. Fill in by hand if needed.
excluded_campaign = ""
posture_note = ""

[knobs]
dedup_days = {{ dedup_days }}
cs_triage_mode = "{{ cs_triage_mode }}"
dry_run = {{ 'true' if dry_run else 'false' }}
autonomous = {{ 'true' if autonomous else 'false' }}
timezone = "{{ timezone }}"
sms_hour = {{ sms_hour }}
reminder_max = {{ reminder_max }}

[sms]
enabled = {{ 'true' if sms_enabled else 'false' }}
# The proxy itself is Vonage, hardcoded, run from mrcall-desktop — no
# per-clone URL to configure; `cs init` never asks.
proxy_base = ""

[drive]
# Niche; `cs init` never asks. Fill in by hand if this clone needs a
# non-default Shared Drive scope.
scope = ""

[cron]
# Declared intent only ([cron] is template-only, ignored by the kernel at
# runtime) — `cs cron install` owns the real crontab entry.
schedule = "{{ cron_schedule }}"
comment = "{{ cron_comment }}"

[env]
platform_env_path = "{{ platform_env_path }}"

[skills]
triage_domain_examples = "company/triage-domain-examples.md"
team_conventions       = "company/team-conventions.md"
campaign_product_notes = "company/campaign-product-notes.md"
operator_out_of_scope  = "company/operator-out-of-scope.md"

[extensions]
modules = []
retired_when_done = false

[repo]
git_remote = "{{ repo_git_remote }}"
docs_shape = "as-built"
kernel_version = "{{ repo_kernel_version }}"