[company]
name = "{{ company_name }}"
display_name = "{{ company_display_name }}"
from_name = "{{ company_from_name }}"
slug = "{{ company_slug }}"
prog_name = "{{ company_prog_name }}"

[operator]
email_address = "{{ email_address }}"
imap_host = "{{ imap_host }}"
imap_port = {{ imap_port }}
smtp_host = "{{ smtp_host }}"
smtp_port = {{ smtp_port }}

[engine]
owner_uid = "{{ engine_owner_uid }}"
ws_url = "{{ engine_ws_url }}"
# Empty on purpose: Settings derives ~/.{{ company_slug }}-cs/firebase-sa.json
# from the slug the moment this is blank — set it only to override that.
sa_path = ""

[engine.accounts]
default = {{ accounts_default | toml_quote }}
{% for name, uid in accounts.items() %}
{{ name | toml_quote }} = {{ uid | toml_quote }}
{% endfor %}

[engine.founder_sweep]
enabled = {{ 'true' if founder_sweep_enabled else 'false' }}
account = "{{ founder_sweep_account }}"

[crm]
adapter = "{{ crm_adapter }}"
{% if crm_adapter == 'shopify' and crm_shopify %}
[crm.shopify]
api_version = "{{ crm_shopify.api_version }}"
env_prefix = "{{ crm_shopify.env_prefix }}"
{% endif %}

[producer]
# A producer adapter's paths are literal filesystem paths on the host that
# runs it, so `cs init` never wires one for a clone. Add the adapter's own
# table by hand (for mrcall-tracking: [producer.mrcall_tracking] with
# script_path and python_path) if this clone genuinely needs it.
adapter = "none"

[campaigns]
# Niche; `cs init` never asks. Fill in by hand if needed.
# excluded_campaign: campaign names a dedicated process owns, so the general
# operator leaves them alone. Comma-separated for more than one
# ("first-campaign, second-campaign"); matched by EXACT name, never by prefix,
# so an excluded "x" does not also exclude "x-batch2" — list both if you mean
# both. `cs config` prints what is actually in force.
excluded_campaign = ""

[knobs]
dedup_days = {{ dedup_days }}
cs_triage_mode = "{{ cs_triage_mode }}"
timezone = "{{ timezone }}"
sms_hour = {{ sms_hour }}
reminder_max = {{ reminder_max }}
# Comma-separated no-reply/system addresses the `unanswered` sweep ignores,
# so a notification robot never looks like a customer waiting for an answer.
# An entry is a literal address UNLESS it contains `*`, `?` or `[`, and then it
# is an fnmatch pattern — `mail-daemon@*`. Patterns exist because bounce daemons
# cannot be listed: the sending host rotates per bounce, so one undeliverable
# address emits a new sender name every time. Write them as narrowly as the
# noise allows; this list decides who is never a customer.
system_senders = {{ system_senders | toml_quote }}
# The model-output send guard (cs/send_guard.py). These two are the only part
# of it that is per-company: how short a composed body may be before the guard
# refuses it, and extra phrases this company never wants to send. The banned
# list EXTENDS the kernel's, it never replaces it. The tells themselves are
# code — a guard with an off switch is a guard that is off.
send_guard_min_chars = {{ send_guard_min_chars }}
send_guard_banned_phrases = {{ send_guard_banned_phrases | toml_quote }}

[sms]
# `enabled` is the whole switch. The send endpoint is a kernel default — the
# mrcall-desktop engine's SMS proxy, shared by every clone — so there is no
# URL to configure and `cs init` never asks. Add `proxy_base = "<url>"` here
# only to point this clone at a different proxy; `cs config` prints the
# endpoint actually in force.
enabled = {{ 'true' if sms_enabled else 'false' }}

[drive]
# Niche; `cs init` never asks. Fill in by hand if this clone needs a
# non-default Shared Drive scope.
scope = ""

[cron]
# Declared intent only ([cron] is template-only, ignored by the kernel at
# runtime) — `cs cron install` owns the real crontab entry.
schedule = "{{ cron_schedule }}"
comment = "{{ cron_comment }}"

[env]
platform_env_path = "{{ platform_env_path }}"

[repo]
git_remote = "{{ repo_git_remote }}"
docs_shape = "as-built"